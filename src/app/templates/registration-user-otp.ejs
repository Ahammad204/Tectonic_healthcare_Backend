<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Tectonic Healthcare - Verify Your Account</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f8f7;
      font-family: Arial, Helvetica, sans-serif;
      color: #17201e;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f4f8f7; padding: 40px 16px"
    >
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 20px;
              overflow: hidden;
              box-shadow: 0 8px 30px rgba(15, 118, 110, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background: linear-gradient(135deg, #0f766e, #115e59);
                  padding: 32px 40px;
                  text-align: center;
                "
              >
                <div
                  style="
                    font-size: 28px;
                    font-weight: 700;
                    color: #ffffff;
                    letter-spacing: -0.5px;
                  "
                >
                  Tectonic
                </div>

                <div
                  style="
                    margin-top: 5px;
                    font-size: 13px;
                    color: #ccfbf1;
                    letter-spacing: 1.5px;
                    text-transform: uppercase;
                  "
                >
                  Healthcare
                </div>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 42px 40px 38px">
                <!-- Verification Icon -->
                <div
                  style="
                    width: 56px;
                    height: 56px;
                    line-height: 56px;
                    text-align: center;
                    border-radius: 50%;
                    background-color: #ccfbf1;
                    color: #0f766e;
                    font-size: 25px;
                    font-weight: 700;
                  "
                >
                  ✓
                </div>

                <h1
                  style="
                    margin: 24px 0 12px;
                    font-size: 28px;
                    line-height: 1.25;
                    color: #17201e;
                  "
                >
                  Verify your account
                </h1>

                <p
                  style="
                    margin: 0 0 18px;
                    font-size: 16px;
                    line-height: 1.7;
                    color: #52615e;
                  "
                >
                  Hello <strong style="color: #17201e"><%= name %></strong>,
                </p>

                <p
                  style="
                    margin: 0 0 28px;
                    font-size: 15px;
                    line-height: 1.7;
                    color: #52615e;
                  "
                >
                  Welcome to Tectonic Healthcare. To complete your registration,
                  please verify your email address using the verification code
                  below.
                </p>

                <!-- Email Address -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                >
                  <tr>
                    <td
                      style="
                        padding: 14px 16px;
                        background-color: #f8faf9;
                        border: 1px solid #e8efed;
                        border-radius: 10px;
                      "
                    >
                      <div
                        style="
                          font-size: 11px;
                          font-weight: 700;
                          color: #7a8884;
                          letter-spacing: 1px;
                          text-transform: uppercase;
                          margin-bottom: 5px;
                        "
                      >
                        Email address
                      </div>

                      <div
                        style="
                          font-size: 14px;
                          color: #34413e;
                          word-break: break-word;
                        "
                      >
                        <%= email %>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- OTP -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="margin-top: 18px"
                >
                  <tr>
                    <td align="center">
                      <div
                        style="
                          background-color: #f0fdfa;
                          border: 1px solid #99f6e4;
                          border-radius: 14px;
                          padding: 24px 20px;
                        "
                      >
                        <div
                          style="
                            font-size: 12px;
                            font-weight: 700;
                            color: #0f766e;
                            letter-spacing: 2px;
                            text-transform: uppercase;
                            margin-bottom: 10px;
                          "
                        >
                          Verification code
                        </div>

                        <div
                          style="
                            font-size: 36px;
                            font-weight: 700;
                            letter-spacing: 8px;
                            color: #115e59;
                            font-family: Arial, Helvetica, sans-serif;
                          "
                        >
                          <%= otpValue %>
                        </div>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Expiration -->
                <p
                  style="
                    margin: 18px 0 0;
                    text-align: center;
                    font-size: 13px;
                    line-height: 1.6;
                    color: #71807c;
                  "
                >
                  This verification code will expire in
                  <strong style="color: #52615e">
                    <%= expirationMinute %> minutes </strong
                  >.
                </p>

                <!-- Security Notice -->
                <div
                  style="
                    margin-top: 30px;
                    padding: 16px 18px;
                    background-color: #fafafa;
                    border-left: 4px solid #0f766e;
                    border-radius: 8px;
                  "
                >
                  <p
                    style="
                      margin: 0;
                      font-size: 13px;
                      line-height: 1.6;
                      color: #687572;
                    "
                  >
                    <strong style="color: #34413e"> Security notice: </strong>
                    Do not share this verification code with anyone. Tectonic
                    Healthcare will never ask you for your verification code.
                  </p>
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  padding: 24px 40px;
                  background-color: #f8faf9;
                  border-top: 1px solid #edf2f0;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0 0 8px;
                    font-size: 13px;
                    font-weight: 600;
                    color: #6b7975;
                  "
                >
                  Tectonic Healthcare
                </p>

                <p
                  style="
                    margin: 0;
                    font-size: 12px;
                    line-height: 1.5;
                    color: #9aa5a2;
                  "
                >
                  This is an automated message. Please do not reply to this
                  email.
                </p>
              </td>
            </tr>
          </table>

          <!-- Outside Footer -->
          <p
            style="
              margin: 18px 0 0;
              font-size: 11px;
              line-height: 1.5;
              color: #9aa5a2;
              text-align: center;
            "
          >
            © Tectonic Healthcare. All rights reserved.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
```
