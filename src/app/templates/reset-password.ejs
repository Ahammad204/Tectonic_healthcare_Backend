<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Tectonic Healthcare - Password Reset Successful</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f8f7;
      font-family: Arial, Helvetica, sans-serif;
      color: #17201e;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f4f8f7; padding: 40px 16px"
    >
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 20px;
              overflow: hidden;
              box-shadow: 0 8px 30px rgba(15, 118, 110, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background: linear-gradient(135deg, #0f766e, #115e59);
                  padding: 32px 40px;
                  text-align: center;
                "
              >
                <div
                  style="
                    font-size: 28px;
                    font-weight: 700;
                    color: #ffffff;
                    letter-spacing: -0.5px;
                  "
                >
                  Tectonic
                </div>

                <div
                  style="
                    margin-top: 5px;
                    font-size: 13px;
                    color: #ccfbf1;
                    letter-spacing: 1.5px;
                    text-transform: uppercase;
                  "
                >
                  Healthcare
                </div>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 48px 40px 42px; text-align: center">
                <!-- Success Icon -->
                <div
                  style="
                    width: 68px;
                    height: 68px;
                    line-height: 68px;
                    margin: 0 auto;
                    border-radius: 50%;
                    background-color: #ccfbf1;
                    color: #0f766e;
                    font-size: 32px;
                    font-weight: bold;
                  "
                >
                  ✓
                </div>

                <h1
                  style="
                    margin: 26px 0 12px;
                    font-size: 28px;
                    line-height: 1.25;
                    color: #17201e;
                  "
                >
                  Password reset successful
                </h1>

                <p
                  style="
                    margin: 0 0 18px;
                    font-size: 16px;
                    line-height: 1.7;
                    color: #52615e;
                  "
                >
                  Hello <strong style="color: #17201e"><%= name %></strong>,
                </p>

                <p
                  style="
                    max-width: 450px;
                    margin: 0 auto 28px;
                    font-size: 15px;
                    line-height: 1.8;
                    color: #52615e;
                  "
                >
                  Your Tectonic Healthcare account password has been
                  successfully updated.
                </p>

                <!-- Status Card -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                >
                  <tr>
                    <td>
                      <div
                        style="
                          padding: 20px;
                          background-color: #f0fdfa;
                          border: 1px solid #ccfbf1;
                          border-radius: 14px;
                        "
                      >
                        <div
                          style="
                            font-size: 14px;
                            font-weight: 700;
                            color: #0f766e;
                            margin-bottom: 6px;
                          "
                        >
                          Your account is secure
                        </div>

                        <div
                          style="
                            font-size: 13px;
                            line-height: 1.6;
                            color: #60716d;
                          "
                        >
                          You can now sign in using your new password.
                        </div>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Security Notice -->
                <div
                  style="
                    margin-top: 28px;
                    padding: 16px 18px;
                    background-color: #fafafa;
                    border-radius: 10px;
                    text-align: left;
                  "
                >
                  <p
                    style="
                      margin: 0;
                      font-size: 13px;
                      line-height: 1.6;
                      color: #687572;
                    "
                  >
                    <strong style="color: #34413e"
                      >Didn't make this change?</strong
                    >
                    Please contact our support team immediately to protect your
                    account.
                  </p>
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  padding: 24px 40px;
                  background-color: #f8faf9;
                  border-top: 1px solid #edf2f0;
                  text-align: center;
                "
              >
                <p style="margin: 0 0 8px; font-size: 13px; color: #6b7975">
                  Tectonic Healthcare
                </p>

                <p
                  style="
                    margin: 0;
                    font-size: 12px;
                    color: #9aa5a2;
                    line-height: 1.5;
                  "
                >
                  This is an automated message. Please do not reply to this
                  email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
